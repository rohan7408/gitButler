{
  "name": "@git-butler/git",
  "version": "0.1.0",
  "type": "module",
  "description": "Safe native Git execution and detection layer for Git Butler",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@git-butler/core": "workspace:*",
    "cross-spawn": "^7.0.6",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/semver": "^7.5.8",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
