{
  "name": "@git-butler/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Model Context Protocol (MCP) Server for Git Butler",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "git-butler-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@git-butler/checkpoints": "workspace:*",
    "@git-butler/core": "workspace:*",
    "@git-butler/git": "workspace:*",
    "@git-butler/github": "workspace:*",
    "@git-butler/permissions": "workspace:*",
    "@git-butler/tasks": "workspace:*",
    "@git-butler/verification": "workspace:*",
    "@git-butler/worktrees": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
