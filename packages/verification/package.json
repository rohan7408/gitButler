{
  "name": "@git-butler/verification",
  "version": "0.1.0",
  "type": "module",
  "description": "Independent task, test, build, and Git state verification engine for Git Butler",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@git-butler/core": "workspace:*",
    "@git-butler/git": "workspace:*",
    "@git-butler/tasks": "workspace:*",
    "@git-butler/worktrees": "workspace:*",
    "cross-spawn": "^7.0.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
